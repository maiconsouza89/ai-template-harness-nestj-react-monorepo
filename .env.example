# Copie para .env (cp .env.example .env). Só valores de desenvolvimento: nenhum segredo real.
# Nomes de host (postgres, valkey, mailpit) são os serviços do compose.yaml; o navegador vê
# a API e a SPA em localhost. A API valida tudo na subida e nomeia a variável que faltar.

# development, test ou production
NODE_ENV=development

# PostgreSQL 18 do Compose (usuário, senha e banco definidos em compose.yaml)
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Valkey 9 do Compose, pelo ioredis
REDIS_URL=redis://valkey:6379

# Better Auth: segredo com 32 ou mais caracteres (troque fora do local) e URL base da API
BETTER_AUTH_SECRET=exemplo-local-troque-por-um-segredo-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Origem da SPA, para CORS e trustedOrigins
WEB_ORIGIN=http://localhost:5173

# Domínio pai do cookie fora do local (crossSubDomainCookies); vazio no local
# COOKIE_DOMAIN=

# SMTP: o Mailpit do Compose não pede credenciais
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# SMTP_USER=
# SMTP_PASSWORD=

# Primeiro admin, criado por make db-setup (senha com 8 ou mais caracteres, letra e número)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=Trocar123

# Exportação OTLP: ausente, a API não exporta telemetria
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Nível do pino: fatal, error, warn, info (padrão), debug, trace ou silent
# LOG_LEVEL=info

# SPA: URL da API vista pelo navegador
VITE_API_URL=http://localhost:3000

# Compose: true liga o polling de arquivos no watch da API e da SPA (repositório em /mnt/c no WSL2)
# WATCH_POLLING=false
