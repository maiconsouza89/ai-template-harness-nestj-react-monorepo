{
  "name": "@app/api",
  "version": "0.0.1",
  "description": "API NestJS",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "generate": "prisma generate",
    "start": "nest start --exec ./bin/node-with-otel.sh",
    "start:dev": "nest start --watch --exec ./bin/node-with-otel.sh",
    "start:debug": "nest start --debug --watch --exec ./bin/node-with-otel.sh",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "oxlint src/ test/ && prettier --check .",
    "test": "vitest run && vitest run --config ./vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config ./vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@better-auth/core": "^1.7.14",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.1",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
