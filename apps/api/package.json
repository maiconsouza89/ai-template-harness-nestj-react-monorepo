{
  "name": "@app/api",
  "version": "0.0.1",
  "description": "API NestJS",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ && prettier --check .",
    "test": "vitest run && vitest run --config ./vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config ./vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
