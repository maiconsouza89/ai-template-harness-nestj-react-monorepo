# Configuração dos testes da API (spec da fundação, "Convenções para as features"): versionado,
# só valores falsos e de baixa entropia, lido pelos dois vitest.config.ts. Os serviços são os do
# Compose vistos do host (portas publicadas); o banco app_test é recriado pelo scripts/test.sh.
NODE_ENV=test
DATABASE_URL=postgresql://app:app@localhost:5432/app_test
# Banco 1 do Valkey: fila email.send e contadores dos testes separados dos do ambiente local
# (banco 0), para o worker da API do Compose não consumir os jobs da integração
REDIS_URL=redis://localhost:6379/1
BETTER_AUTH_SECRET=segredo-de-teste-sem-valor-real-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Sem proxies confiáveis: cada caso manda o próprio X-Forwarded-For de um valor só
TRUSTED_PROXIES=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# API REST do Mailpit do Compose, só para os testes lerem a caixa (test/mailpit.ts)
MAILPIT_URL=http://localhost:8025
LOG_LEVEL=silent
# Primeiro admin do banco app_test (pré-requisito admin-inicial do contrato, via test/factories)
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=Teste1234
